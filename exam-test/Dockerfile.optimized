# Multi-stage build để tối ưu kích thước image
FROM maven:3.9.6-openjdk-21 AS builder

# Thiết lập thông tin metadata
LABEL maintainer="Online Exam Platform"
LABEL version="1.0"
LABEL description="Spring Boot application for Online Exam Platform"

# Tạo thư mục làm việc
WORKDIR /app

# Copy pom.xml trước để cache dependencies
COPY pom.xml .

# Download dependencies (cache layer)
RUN mvn dependency:go-offline -B

# Copy source code
COPY src src

# Build ứng dụng
RUN mvn clean package -DskipTests

# Runtime stage
FROM openjdk:21-jdk-slim

# Cài đặt curl cho health check
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Tạo thư mục làm việc
WORKDIR /app

# Copy JAR file từ builder stage
COPY --from=builder /app/target/*.jar app.jar

# Tạo thư mục cho logs
RUN mkdir -p /app/logs

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8080/actuator/health || exit 1

# Command để chạy ứng dụng
CMD ["java", "-jar", "app.jar"] 